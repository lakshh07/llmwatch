# Copy to .env and fill in. Never commit the real .env.

# Required
LLMWATCH_DATABASE_URL=postgresql+psycopg://llmwatch:llmwatch@localhost:5432/llmwatch
LLMWATCH_API_KEY=change-me

# Optional (defaults shown)
# LLMWATCH_REDIS_URL=redis://localhost:6379
# LLMWATCH_ALERT_INTERVAL_SECONDS=60
# LLMWATCH_RECLAIM_IDLE_MS=60000     # pending this long = stuck, another worker takes over
# LLMWATCH_MAX_DELIVERIES=5          # then the message goes to the dead-letter stream

# LLM-as-judge (off by default; costs money when on). Run `llmwatch-judge` too.
# LLMWATCH_JUDGE_ENABLED=true
# LLMWATCH_JUDGE_MODEL=claude-haiku-5-5
# LLMWATCH_ANTHROPIC_API_KEY=sk-ant-...
